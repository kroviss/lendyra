<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS safety net for buyers who point the site root at the project root
  instead of public/ (the documented setup — see docs/INSTALL.md). Denies
  direct access to source, environment and storage directories.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="bootstrap" />
          <add segment="config" />
          <add segment="database" />
          <add segment="lang" />
          <add segment="resources" />
          <add segment="routes" />
          <add segment="scripts" />
          <add segment="src" />
          <add segment="storage" />
          <add segment="tests" />
          <add segment="vendor" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="/." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
